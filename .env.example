# ─────────────────────────────────────────────────────────────────────────────
# DuupFlow — variables d'environnement
#
# Copie ce fichier en `.env.local` et remplis les valeurs.
#   cp .env.example .env.local
#
# `.env.local` n'est JAMAIS versionné (voir .gitignore). Ce fichier-ci ne
# contient que des NOMS et des exemples — aucun secret réel ne doit y entrer.
#
# Légende :
#   [REQUIS]   l'application ne démarre pas ou casse sans
#   [OPTION]   a une valeur par défaut dans le code, à ne toucher qu'au besoin
#   [MORT]     lu par du code qui n'est plus accessible dans l'app (voir README)
#
# Pour un développement local minimal, seules les lignes [REQUIS] du bloc
# « SOCLE » et « SUPABASE » sont nécessaires : le reste dégrade proprement.
# ─────────────────────────────────────────────────────────────────────────────


# ═══ SOCLE ═══════════════════════════════════════════════════════════════════

# [OPTION] URL publique du site. Sert aux liens dans les emails, aux retours
# Stripe et aux liens d'affiliation. En local, laisse http://localhost:3000.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# [OPTION] Doublon historique de NEXT_PUBLIC_APP_URL, lu à un seul endroit
# (dashboard/enhance). À fusionner un jour.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# [OPTION] Dossier où atterrissent les fichiers produits (vidéos dupliquées,
# rendus de l'éditeur IA, images). En production c'est un volume persistant.
OUT_BASE=./.out

# [REQUIS EN PRODUCTION] Secret partagé pour les tâches planifiées
# (/api/cron/*). Génère une chaîne aléatoire longue ; la requête cron doit la
# présenter en en-tête : Authorization: Bearer <CRON_SECRET>
#
# ⚠️ ATTENTION — le contrôle est écrit `if (secret && auth !== ...)` : quand la
#    variable est VIDE, la vérification est purement et simplement SAUTÉE et
#    n'importe qui peut déclencher le nettoyage, qui SUPPRIME des fichiers.
#    Elle doit donc être renseignée en production. (Cron routes : fail-open —
#    à inverser, contrairement à ADMIN_USER_ID qui refuse bien par défaut.)
CRON_SECRET=

# [OPTION] Identifiant utilisateur Supabase autorisé sur /admin.
# Vide = /admin est inaccessible pour tout le monde (refus par défaut, correct).
ADMIN_USER_ID=


# ═══ SUPABASE (base de données + authentification) ═══════════════════════════
# Tableau de bord Supabase → Project Settings → API

# [REQUIS] URL du projet.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# [REQUIS] Clé publique (exposée au navigateur, c'est normal).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# [REQUIS] Clé service_role — CONTOURNE TOUTES LES RÈGLES DE SÉCURITÉ.
# Ne doit jamais être exposée au navigateur ni commitée.
SUPABASE_SERVICE_ROLE_KEY=

# [REQUIS pour `npm run prestart`] Chaîne de connexion Postgres directe,
# utilisée UNIQUEMENT par scripts/migrate.cjs.
# ⚠️ En pratique elle n'est pas renseignée en production : les migrations sont
#    appliquées à la main dans l'éditeur SQL de Supabase. Voir README.
SUPABASE_DB_URL=


# ═══ STRIPE (paiement, abonnements) ══════════════════════════════════════════
# Tableau de bord Stripe → Developers → API keys / Products

# [REQUIS] Clé secrète (sk_test_… en développement).
STRIPE_SECRET_KEY=

# [REQUIS] Secret de signature du webhook. En local :
#   stripe listen --forward-to localhost:3000/api/stripe/webhook
STRIPE_WEBHOOK_SECRET=

# Identifiants de tarif, un par plan. Les créer dans Stripe → Products.
STRIPE_PRICE_ID_STARTER=   # [REQUIS]
STRIPE_PRICE_ID_SOLO=      # [OPTION] retombe sur STRIPE_PRICE_ID
STRIPE_PRICE_ID_PRO=       # [OPTION] retombe sur STRIPE_PRICE_ID
STRIPE_PRICE_ID=           # [REQUIS] tarif de repli pour SOLO et PRO

# [OPTION] Emails qui reçoivent le plan Pro gratuitement, sans passer par
# Stripe (séparés par des virgules). Sert aux comptes de démonstration.
COMP_PRO_EMAILS=


# ═══ ÉDITEUR IA — services externes ══════════════════════════════════════════

# [OPTION] Analyse visuelle des vidéos de référence (Google AI Studio).
# GEMINI_API_KEY et GOOGLE_API_KEY sont interchangeables : la première trouvée
# gagne. Sans clé, l'analyse est partielle et l'app le signale explicitement.
GEMINI_API_KEY=
GOOGLE_API_KEY=

# [OPTION] Modèle Gemini et cadence de lecture vidéo (images/seconde).
AI_EDITOR_GEMINI_MODEL=gemini-flash-latest
AI_EDITOR_GEMINI_FPS=2

# [REQUIS pour la transcription] Deepgram — transcription mot à mot horodatée.
# C'est la source principale ; Groq sert de repli.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-2      # [OPTION]
DEEPGRAM_LANGUAGE=fr       # [OPTION]

# [OPTION] Groq — repli de transcription + choix des plans (« directeur »).
GROQ_API_KEY=
GROQ_DIRECTOR_MODEL=

# [REQUIS pour l'éditeur IA] Secret de signature des jetons OAuth du connecteur
# MCP. Génère une chaîne aléatoire longue.
OAUTH_SECRET=

# [OPTION] Restreint l'éditeur IA à une liste d'emails (séparés par des
# virgules). Vide = ouvert à tous ceux dont le plan l'autorise.
AI_EDITOR_ALLOWLIST=

# [OPTION] Bascule l'éditeur IA en mode « en ligne ».
AI_EDITOR_LIVE=


# ═══ ÉDITEUR IA — réglages du moteur de rendu ════════════════════════════════
# Tous ont une valeur par défaut. À ne toucher que pour ajuster la production.

AI_EDITOR_MAX_RENDERS=2              # rendus simultanés (au-delà : file d'attente)
AI_EDITOR_FFMPEG_THREADS=4           # threads ffmpeg par rendu
AI_EDITOR_RENDER_DEADLINE_MS=480000  # abandon d'un rendu trop long
AI_EDITOR_FIRST_WAIT_MS=25000        # attente avant de rendre un ticket au client MCP
AI_EDITOR_POLL_WAIT_MS=25000         # attente par appel à get_render
AI_EDITOR_RENDER_KEYFRAMES=3         # images renvoyées après un rendu
AI_EDITOR_MAX_SEGMENT_INPUTS=20      # plafond d'entrées ffmpeg par montage
AI_EDITOR_PROXY_SHORT_EDGE=1080      # taille des proxies (rushs 4K allégés)
AI_EDITOR_FFMPEG_FULL=               # chemin d'un ffmpeg avec zscale (tonemap HDR)
AI_EDITOR_SHARE_FROM=                # réservé


# ═══ MÉDIA (ffmpeg, yt-dlp, polices) ═════════════════════════════════════════

# [OPTION] Chemins des binaires. Laisse vide en production : le code choisit
# automatiquement (ffmpeg-static). En local sur Mac ARM, pointe vers Homebrew —
# ffmpeg-static ne s'y installe pas et le ffmpeg de Homebrew sait tonemapper.
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg   ← décommente sur Mac ARM uniquement
FFMPEG_PATH=
FFMPEG_BIN=
YTDLP_BIN=

# [OPTION] Navigateur dont yt-dlp emprunte les cookies (téléchargement de réfs).
STUDIO_YTDLP_BROWSER=

# [OPTION] Fichier de configuration fontconfig, pour que ffmpeg trouve les
# polices des sous-titres. Utile seulement si le rendu perd ses polices.
FONTCONFIG_FILE=


# ═══ DUPLICATION VIDÉO / IMAGE — plafonds de charge ══════════════════════════
# Sans ces plafonds, ffmpeg prend tous les cœurs de la machine et étouffe le
# reste. Voir le commentaire dans src/app/dashboard/videos/processVideos.ts.

FFMPEG_VCPU=8                  # cœurs alloués par tâche de duplication
MAX_CONCURRENT_ENCODES=2       # encodages vidéo simultanés (toutes requêtes)
MAX_CONCURRENT_IMAGE_OPS=      # opérations image simultanées
MAX_CONCURRENT_UPLOADS=        # envois simultanés
SHARP_CONCURRENCY=             # threads de la bibliothèque image (sharp)


# ═══ EMAILS ══════════════════════════════════════════════════════════════════

# [REQUIS pour les emails transactionnels] Brevo.
BREVO_API_KEY=
BREVO_LIST_FREE_USERS=         # [OPTION] identifiants de listes Brevo
BREVO_LIST_ACTIVE_CLIENTS=     # [OPTION]
BREVO_LIST_CHURNED=            # [OPTION]

# [OPTION] SMTP direct — chemin alternatif à Brevo.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=


# ═══ INTÉGRATIONS EXTERNES ═══════════════════════════════════════════════════

# [REQUIS pour « importe ton compte »] Apify — récupération des vidéos les plus
# performantes d'un compte Instagram/TikTok.
APIFY_TOKEN=

# [OPTION] Google Drive Picker — import de fichiers depuis Drive.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_API_KEY=

# [OPTION] Génération d'images par IA (/dashboard/generate).
WAVESPEED_API_KEY=


# ═══ VARIABLES FOURNIES PAR L'HÉBERGEUR ══════════════════════════════════════
# Ne pas définir à la main — la plateforme les pose elle-même.
#   NODE_ENV            development | production
#   NEXT_RUNTIME        nodejs | edge
#   VERCEL              présent si déployé sur Vercel
#   RENDER_EXTERNAL_URL présent si déployé sur Render


# ═══ CODE MORT — à supprimer avec les modules concernés ══════════════════════
# Ces variables ne sont lues que par du code inaccessible depuis l'application.
# Voir la section « Dettes connues » du README.
#
#   ANTHROPIC_API_KEY    ┐
#   STUDIO_LLM_PROVIDER  │ module /studio (générateur de reels abandonné)
#   STUDIO_LLM_MODEL     │
#   STUDIO_RENDERER      │
#   WHISPER_BIN          │
#   WHISPER_MODEL        ┘
#
#   REPLICATE_API_TOKEN  → /dashboard/enhance, page sans lien entrant
